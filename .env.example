# 要る鍵の名前だけ。値は自分の物を入れる。このファイルは見本で、道具は読まない。
# 置き場はそれぞれの行の上に書いた所。

# 審査の判断の層（OpenRouter）。置き場: ~/.config/jev/.env に「OPENROUTER_API_KEY=...」の1行。
# 無くても審査は Opus だけで回る。
OPENROUTER_API_KEY=

# 本人への通知（Telegram）。置き場: ~/.telegram-arukoto.json に {"token": "...", "chat_id": "..."}。
# 無くても記事は作れる（通知が飛ばないだけ）。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
